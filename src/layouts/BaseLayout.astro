---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { asset } from '../lib/path';

interface Props {
  title?: string;
  description?: string;
  /** OG 이미지 (public 기준 경로 또는 절대 URL) */
  image?: string;
  /** 홈(챕터 화면). 푸터를 짧게 줄인다 (연락처는 챕터 04 에 있음) */
  home?: boolean;
}

const { title, description = SITE.description, image, home = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const ogImage = image
  ? /^https?:\/\//.test(image)
    ? image
    : new URL(asset(image.replace(/^\//, '')), Astro.site ?? SITE.url).toString()
  : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />

    <!-- 글꼴: IBM Plex Sans KR 한 가지 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600&display=swap" />

  </head>
  <body class={home ? "is-home" : undefined}>
    <Header />
    <main class="site-main">
      <slot />
    </main>
    <Footer compact={home} />

    <!-- 방문 통계 트래커 (자체 구현, 우리 Firestore). localhost 에서는 자동 비활성. -->
    <script
      is:inline
      src={asset('analytics/tracker.js')}
      data-project="portfolio-b4bc3"
      data-key="AIzaSyA_PytDMagpwyaM7OWda73TPDyMLvIv5GM"
      data-site="somnium0915-portfolio"
    ></script>
  </body>
</html>
