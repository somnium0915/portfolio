---
import { toPdfDocs } from '../lib/pdf';

interface Props {
  pdf: unknown;
}

const docs = toPdfDocs(Astro.props.pdf);
// Drive 개별 파일은 뷰어가 페이지 단위로 스트리밍하므로 처음부터 펼쳐서 바로 보여준다.
// 폴더(단순 목록)·직접 URL(대용량 통다운 위험)은 접어 둔다.
const openByDefault = (d: (typeof docs)[number]) => d.isDrive && !d.isFolder;
---

{
  docs.length > 0 && (
    <section class="pdf-embed" aria-label="첨부 문서">
      {docs.map((d) => (
        <div class="pdf-doc">
          <div class="pdf-doc__bar">
            <span class="pdf-doc__name">
              {d.isFolder ? '📁' : '📄'} {d.label}
            </span>
            <span class="pdf-doc__links">
              <a href={d.open} target="_blank" rel="noopener">
                {d.isFolder ? 'Drive 폴더 열기' : '새 탭에서 열기'} ↗
              </a>
              {d.download && (
                <a href={d.download} target="_blank" rel="noopener">
                  다운로드
                </a>
              )}
            </span>
          </div>
          <details class="pdf-doc__preview" open={openByDefault(d)}>
            <summary>{d.isFolder ? '파일 목록 열기' : '미리보기'}</summary>
            <div class="pdf-doc__frame" data-folder={d.isFolder ? '' : undefined}>
              <iframe
                data-src={d.preview}
                loading="lazy"
                title={`${d.label} ${d.isFolder ? '파일 목록' : '미리보기'}`}
                referrerpolicy="no-referrer"
                allow="autoplay"
              />
            </div>
            <p class="pdf-doc__hint">
              {d.isFolder
                ? '파일을 클릭하면 Google Drive 에서 열립니다. 이 폴더에 파일을 추가하면 자동으로 여기 나타납니다.'
                : '미리보기가 안 보이면 위의 “새 탭에서 열기”를 사용하세요 (특히 모바일).'}
            </p>
          </details>
        </div>
      ))}
    </section>
  )
}

<script>
  // 대용량 PDF / 폴더 뷰를 페이지 진입 시 받지 않도록, <details> 가 열릴 때만 iframe src 를 채운다.
  document.querySelectorAll<HTMLDetailsElement>('.pdf-doc__preview').forEach((d) => {
    const fill = () => {
      if (!d.open) return;
      const frame = d.querySelector<HTMLIFrameElement>('iframe[data-src]');
      if (frame?.dataset.src) {
        frame.src = frame.dataset.src;
        frame.removeAttribute('data-src');
      }
    };
    d.addEventListener('toggle', fill);
    fill(); // 처음부터 open 상태면 즉시 로드
  });
</script>
