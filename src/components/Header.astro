---
import { SITE, SECTIONS } from '../consts';
import { withBase } from '../lib/path';

const current = Astro.url.pathname.replace(/\/+$/, '');
const home = withBase().replace(/\/$/, '');
const isHome = current === home;
const isActive = (slug: string) => current === withBase(slug) || current.startsWith(withBase(slug) + '/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase()} aria-current={isHome ? 'page' : undefined}>
      <span class="brand__name">{SITE.author}</span>
      <span class="brand__role">게임 기획</span>
    </a>

    <nav class="nav" aria-label="주요 섹션">
      {
        SECTIONS.filter((s) => !('hidden' in s && s.hidden)).map((s) => (
          <a href={withBase(s.slug)} aria-current={isActive(s.slug) ? 'page' : undefined}>
            {s.label}
          </a>
        ))
      }
      <a href={`${withBase()}#contact-end`}>연락</a>
    </nav>
  </div>
</header>
