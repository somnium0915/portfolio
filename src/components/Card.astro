---
import type { DecoratedEntry } from '../lib/content';
import { formatDate } from '../lib/content';
import { resolveMedia } from '../lib/path';

interface Props {
  entry: DecoratedEntry;
  /** 섹션 이름을 표시할지 (섹션 전용 목록에서는 끔) */
  showSection?: boolean;
}

/** 문서 목록 한 줄: 날짜 | 제목·요약 | 태그 | 16:9 썸네일. 줄 전체가 링크 */
const { entry, showSection = true } = Astro.props;
const { data } = entry;
const cover = resolveMedia(data.cover);
const tags = (data.tags ?? []).slice(0, 3);
---

<article class="row">
  <p class="row__date">
    <time datetime={new Date(data.date).toISOString()}>{formatDate(data.date)}</time>
    {showSection && <span>{entry.sectionLabel}</span>}
  </p>
  <div class="row__text">
    <h3 class="row__title">
      <a href={entry.href}>{String(data.title).split(/\s+—\s+/).join(', ')}</a>
    </h3>
    {data.summary && <p class="row__summary">{data.summary}</p>}
  </div>
  {
    tags.length > 0 ? (
      <ul class="row__tags" aria-label="태그">
        {tags.map((t) => (
          <li>{t}</li>
        ))}
      </ul>
    ) : (
      <span />
    )
  }
  <span class="row__thumb" aria-hidden="true">
    {cover && <img src={cover} alt="" loading="lazy" />}
  </span>
</article>
