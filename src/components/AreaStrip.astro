---
/**
 * 맡은 영역: "주도 기획, UI, 구현 / 함께 시스템" 처럼 글로만 적는다.
 * 칩(동그란 카드)·기호는 쓰지 않는다. 안 맡은 영역은 쓰지 않는다.
 * 쓰는 곳: 홈 대표 작업 카드, 프로젝트 상세 정보 줄
 * 데이터: 프로젝트 frontmatter 의 areas (웹 편집기 "프로젝트 → 맡은 영역")
 */
import { AREAS } from '../consts';

interface Props {
  areas?: Record<string, string | undefined>;
}

const areas = Astro.props.areas ?? {};
const groups = (
  [
    ['주도', '주도'],
    ['공동', '함께'],
  ] as const
)
  .map(([value, label]) => ({
    label,
    names: AREAS.filter(([key]) => areas[key] === value).map(([, name]) => name),
  }))
  .filter((g) => g.names.length > 0);
---

{
  groups.length > 0 && (
    <p class="area-strip">
      {groups.map((g) => (
        <span class="area-strip__group">
          <span class="area-strip__label">{g.label}</span> {g.names.join(', ')}
        </span>
      ))}
    </p>
  )
}
