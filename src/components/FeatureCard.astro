---
import type { DecoratedEntry } from '../lib/content';
import { LINK_META } from '../lib/content';
import { resolveMedia } from '../lib/path';
import AreaStrip from './AreaStrip.astro';

interface Props {
  entry: DecoratedEntry;
}

/**
 * 챕터 02 대표 작업 한 단:
 * 16:9 화면 → 제목·한 줄 → 역할·팀·기간 → 맡은 영역 → 기획 의도 세 줄 → 링크
 */
const { entry } = Astro.props;
const { data } = entry;
const d = data as Record<string, unknown>;
const cover = resolveMedia(data.cover);
const links = Object.entries(data.links ?? {}).filter(([, v]) => Boolean(v)) as [string, string][];
const [titleMain, titleSub] = String(data.title).split(/\s+—\s+/);
const facts = (
  [
    ['역할', d.role],
    ['팀', d.team],
    ['기간', d.period],
  ] as [string, unknown][]
).filter(([, v]) => typeof v === 'string' && v.length > 0) as [string, string][];
const highlights = ((d.highlights as string[] | undefined) ?? []).filter(Boolean);
const areas = d.areas as Record<string, string | undefined> | undefined;
---

<article class="work">
  <a class="work__screen" href={entry.href} tabindex="-1" aria-hidden="true">
    {cover ? <img src={cover} alt="" loading="lazy" /> : <span class="plate">{titleMain}</span>}
  </a>

  <div class="work__head">
    <h3 class="work__title">
      <a href={entry.href}>{titleMain}</a>
    </h3>
    {titleSub && <p class="work__sub">{titleSub}</p>}
  </div>

  {
    facts.length > 0 && (
      <dl class="work__facts">
        {facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <AreaStrip areas={areas} />

  {
    highlights.length > 0 ? (
      <ul class="work__highlights" aria-label="기획 의도">
        {highlights.slice(0, 3).map((h) => {
          const i = h.indexOf(': ');
          return i > 0 ? (
            <li>
              <strong>{h.slice(0, i)}</strong> {h.slice(i + 2)}
            </li>
          ) : (
            <li>{h}</li>
          );
        })}
      </ul>
    ) : (
      data.summary && <p class="work__summary">{data.summary}</p>
    )
  }

  <p class="work__links">
    <a class="more" href={entry.href}>자세히 보기</a>
    {
      links.slice(0, 3).map(([key, href]) => (
        <a class="extlink" href={href} target="_blank" rel="noopener">
          {LINK_META[key]?.label ?? key} ↗
        </a>
      ))
    }
  </p>
</article>
