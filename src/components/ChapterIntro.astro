---
/**
 * 챕터 04 — 기획 철학.
 * 왼쪽: 슬로건을 크게 두 줄 | 오른쪽: 이 문장을 고른 이유
 * 이 챕터에서 힘을 주는 곳은 슬로건 글자 하나뿐이다. 나머지는 조용히 둔다.
 * 문구: site.json → hero.tagline (슬로건), principles.reason (이유)
 */
import { SITE, PRINCIPLES } from '../consts';

const lines = String(SITE.tagline)
  .split(/\r?\n/)
  .filter((l) => l.trim().length > 0);
const p = PRINCIPLES;
---

<section class="chapter" id="philosophy" data-chapter="04" aria-labelledby="philosophy-title">
  <div class="chapter__inner">
    <h2 class="chapter__title" id="philosophy-title">{p?.title ?? '기획 철학'}</h2>

    <div class="approach">
      <p class="approach__quote">{lines.map((l) => <span>{l}</span>)}</p>
      {p?.reason && <p class="approach__why">{p.reason}</p>}
    </div>
  </div>
</section>
