---
/**
 * 연락 칸. 홈 챕터 04 마지막 줄과 소개 페이지 맨 아래에 같은 모양으로 쓴다.
 * 왼쪽: 연락 (메일, GitHub) | 오른쪽: 인적 사항 (생년, 거주지, 연락처. 있을 때만)
 * 다른 페이지 푸터의 연락 줄은 Footer.astro 에 따로 있다.
 */
import { PROFILE, CONTACT } from '../consts';

interface Props {
  id?: string;
  /** 인적 사항을 함께 보여 줄지 */
  showFacts?: boolean;
}

const { id, showFacts = false } = Astro.props;
const prof = PROFILE ?? {};
const email = prof.email || CONTACT.email;
const facts = (
  [
    ['생년', prof.birth],
    ['거주지', prof.location],
    ['연락처', prof.phone],
  ] as [string, string | undefined][]
).filter(([, v]) => v && v.trim());
---

<div class="closing" id={id}>
  <div class="closing__contact">
    <h3 class="cv__head">연락</h3>
    {
      email && (
        <a class="cv__mail" href={`mailto:${email}`}>
          {email}
        </a>
      )
    }
    {
      CONTACT.github && (
        <a class="extlink" href={CONTACT.github} target="_blank" rel="noopener">
          GitHub ↗
        </a>
      )
    }
  </div>
  {
    showFacts && facts.length > 0 && (
      <dl class="closing__facts">
        {facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    )
  }
</div>
