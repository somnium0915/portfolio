---
import { SITE, SOCIALS } from '../consts';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>
      © {year} {SITE.author}
      {
        SOCIALS.length > 0 && (
          <>
            {' · '}
            {SOCIALS.map((s, i) => (
              <>
                {i > 0 && ' · '}
                <a href={s.href} target="_blank" rel="me noopener">
                  {s.label}
                </a>
              </>
            ))}
          </>
        )
      }
    </p>
    <p>Built with Astro · Deployed on GitHub Pages</p>
  </div>
</footer>
