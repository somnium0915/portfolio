---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Card from '../../components/Card.astro';
import { SECTIONS } from '../../consts';
import { loadSection } from '../../lib/content';

export const getStaticPaths = (() =>
  SECTIONS.map((s) => ({ params: { section: s.slug }, props: { section: s } }))) satisfies GetStaticPaths;

const { section } = Astro.props;
const entries = await loadSection(section.collection);
---

<BaseLayout title={section.label} description={section.description}>
  <section class="container page" id={section.slug}>
    <header class="page-intro">
      <h1>
        {section.label} <span class="count">{entries.length}</span>
      </h1>
      <p>{section.description}</p>
    </header>

    {/* 글 수가 적어 태그 필터는 두지 않는다. 태그는 각 줄에 표시만 한다 */}
    {
      entries.length === 0 ? (
        <p class="empty">{`아직 올린 ${section.label}가 없습니다.`}</p>
      ) : (
        <div class="rows">
          {entries.map((entry) => (
            <Card entry={entry} showSection={false} />
          ))}
        </div>
      )
    }
  </section>
</BaseLayout>
