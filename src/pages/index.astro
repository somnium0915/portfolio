---
import BaseLayout from '../layouts/BaseLayout.astro';
import CardGrid from '../components/CardGrid.astro';
import SkillGrid from '../components/SkillGrid.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { SITE, SECTIONS, FEATURED, SKILLS } from '../consts';
import { loadSection, loadFeatured } from '../lib/content';
import { withBase } from '../lib/path';

const featured = await loadFeatured();

const sections = await Promise.all(
  SECTIONS.map(async (s) => ({
    def: s,
    entries: (await loadSection(s.collection)).slice(0, 3),
  })),
);
---

<BaseLayout>
  <section class="hero" id="intro">
    <h1>{SITE.tagline}</h1>
    <p>{SITE.intro}</p>
  </section>

  {
    SKILLS.enabled !== false && SKILLS.items.length > 0 && (
      <section class="section-block" id="skills">
        <div class="section-head">
          <div>
            <h2>{SKILLS.title}</h2>
            {SKILLS.note && <p>{SKILLS.note}</p>}
          </div>
        </div>
        <SkillGrid items={SKILLS.items} />
      </section>
    )
  }

  {
    featured.length > 0 && (
      <section class="section-block featured-block" id="featured">
        <div class="section-head">
          <div>
            <h2>{FEATURED.title}</h2>
            {FEATURED.note && <p>{FEATURED.note}</p>}
          </div>
        </div>
        <div class="feature-list">
          {featured.map((entry) => <FeatureCard entry={entry} />)}
        </div>
      </section>
    )
  }

  <div class="archive">
    <div class="archive-head">
      <div>
        <h2>아카이브</h2>
        <p>프로젝트 · 기획서 · 분석서를 종류별로 모아둔 곳</p>
      </div>
    </div>
    {
      sections.map(({ def, entries }) => (
        <section class="section-block" id={`home-${def.slug}`}>
          <div class="section-head">
            <div>
              <h2>{def.label}</h2>
              <p>{def.description}</p>
            </div>
            <a href={withBase(def.slug)}>전체 보기 →</a>
          </div>
          <CardGrid
            entries={entries}
            showSection={false}
            emptyText={`${def.label} 항목이 아직 없습니다.`}
          />
        </section>
      ))
    }
  </div>
</BaseLayout>
