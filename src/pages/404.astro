---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/path';
---

<BaseLayout title="페이지를 찾을 수 없음">
  <div class="container page">
    <header class="page-intro">
      <h1>404</h1>
      <p>요청한 페이지가 없습니다. 주소를 확인하거나 홈에서 다시 찾아 주세요.</p>
    </header>
    <p style="margin-top:2rem"><a class="btn btn--solid" href={withBase()}>홈으로</a></p>
  </div>
</BaseLayout>
